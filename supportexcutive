    function submitScenario(id) {
      const val = document.getElementById(`sc-input-${id}`).value.trim();
      const status = document.getElementById(`sc-status-${id}`);
      if (val.length < 15) {
        alert('Please provide a comprehensive technical response (minimum 15 characters).');
        return;
      }
      completedScenarios.add(id);
      status.innerHTML = '? Submitted';
      status.style.color = '#22c55e';
      status.style.fontWeight = 'bold';
      document.getElementById(`sc-card-${id}`).style.borderLeftColor = '#22c55e';
      updateProgress();
    }

    function updateProgress() {
      const count = completedScenarios.size;
      document.getElementById('completed-count').innerText = `${count} / 20`;
      const pct = Math.round((count / 20) * 100);
      document.getElementById('completion-percent').innerText = `${pct}%`;
      document.getElementById('main-progress').style.width = `${pct}%`;
    }

    function submitExam() {
      let score = 0;
      quizQuestions.forEach(q => {
        const checked = Array.from(document.querySelectorAll(`input[name="q-${q.id}"]:checked`)).map(cb => parseInt(cb.value));
        const correct = q.correct;
        const ok = checked.length === correct.length && checked.every(v => correct.includes(v));
        if (ok) score++;
      });
      const pct = Math.round((score / quizQuestions.length) * 100);
      alert(pct >= 80 ? `?? PASSED! Score: ${pct}%` : `? FAILED. Score: ${pct}% (>=80% required)`);
    }


    function setupProctoring() {
      document.addEventListener('visibilitychange', () => {
        const stat = document.getElementById('p-status');
        const focus = document.getElementById('mon-focus');
        if (document.hidden) {
          if (stat) { stat.innerText = '?? TAB SWITCH DETECTED'; stat.style.color = '#ef4444'; }
          if (focus) { focus.innerText = '? Focus Lost'; focus.style.color = '#ef4444'; }
        } else {
          if (stat) { stat.innerText = '? SECURE SESSION'; stat.style.color = '#4ade80'; }
          if (focus) { focus.innerText = '? Focus Verified'; focus.style.color = '#4ade80'; }
        }
      });

      document.addEventListener('copy', (e) => e.preventDefault());
      document.addEventListener('paste', (e) => e.preventDefault());
      document.addEventListener('keydown', (e) => {
        if (e.key === 'PrintScreen' || (e.ctrlKey && (e.key === 'p' || e.key === 'c' || e.key === 'v'))) {
          e.preventDefault();
        }
      });
    }

    function enterProctoredEnvironment() {
      document.getElementById('policy-modal').style.display = 'none';
      if (document.documentElement.requestFullscreen) {
        document.documentElement.requestFullscreen().catch(() => {});
      }
    }

